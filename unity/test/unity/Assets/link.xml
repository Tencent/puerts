<linker>
 
    <!-- This fixes GameSparks 'ERROR: The authentication
          or decryption has failed' errors when stripping is enabled -->
 
     <assembly fullname="Assembly-CSharp">
         <type fullname="UnityEngine.Debug" preserve="all"/>
         <type fullname="PuertsTest.TestHelper" preserve="all"/>
         <type fullname="PuertsTest.TestStruct" preserve="all"/>
         <type fullname="PuertsTest.TestObject" preserve="all"/>
     </assembly>
     <!-- 用例全靠反射发现和调用，Tester 里也不再 typeof 引用该程序集的类型，整个程序集都不能裁 -->
     <assembly fullname="com.tencent.puerts.unittest" preserve="all"/>
 
</linker>